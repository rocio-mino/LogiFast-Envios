// Descubre únicamente contenedores del proyecto Compose LogiFast-Envios.
discovery.docker "logifast" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "logifast_labels" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "logifast-envios"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

loki.source.docker "logifast" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.logifast.targets
  labels        = { platform = "docker" }
  relabel_rules = discovery.relabel.logifast_labels.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
