# Copiar a .env para cambiar valores (el archivo .env está en .gitignore).
# Todos tienen valor por defecto, así que .env es opcional en local.

# Puerto publicado por el balanceador
PORT=8080

# Imagen y versión (en el pipeline IMAGE_TAG = SHA corto del commit)
IMAGE_NAME=duoc/jv0101-caso17-envios
IMAGE_TAG=1.0.0
GIT_COMMIT=local

# Escalabilidad
APP_REPLICAS=2
DB_POOL_SIZE=10
TOMCAT_MAX_THREADS=100

# Base de datos (en el pipeline la clave se genera aleatoriamente en cada despliegue)
DB_NAME=envios
DB_USER=envios
DB_PASSWORD=envios_local_dev
